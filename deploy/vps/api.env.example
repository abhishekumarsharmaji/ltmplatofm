# Copy to /etc/coreskils/api.env and replace every CHANGE_ME value.
# Never commit the completed file.
NODE_ENV=production
PORT=4000
PUBLIC_APP_URL=https://coreskils.org
DATABASE_URL=postgresql://coreskils:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/coreskils
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# Required for uploads and protected digital files on a standalone VPS.
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=CHANGE_ME

# Optional: required only when enabling live classes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: required only when enabling AI studio features.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=