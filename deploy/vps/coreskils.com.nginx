server {
    listen 80;
    listen [::]:80;
    server_name coreskils.com www.coreskils.com;

    root /opt/coreskils/app/artifacts/lms-front/dist/public;
    index index.html;

    client_max_body_size 260m;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    # Crawlable public pages are rendered by the Express SEO shell.
    location = /sitemap.xml { proxy_pass http://127.0.0.1:4000; }
    location = /robots.txt { proxy_pass http://127.0.0.1:4000; }
    location = / { proxy_pass http://127.0.0.1:4000; }
    location = /courses { proxy_pass http://127.0.0.1:4000; }
    location ~ ^/courses/(?:[0-9]+|[a-z0-9]+(?:-[a-z0-9]+)*)$ { proxy_pass http://127.0.0.1:4000; }
    location = /products { proxy_pass http://127.0.0.1:4000; }
    location ~ ^/products/(?:[0-9]+|[a-z0-9]+(?:-[a-z0-9]+)*)$ { proxy_pass http://127.0.0.1:4000; }
    location ~ ^/creators/[a-z0-9_]{3,30}$ { proxy_pass http://127.0.0.1:4000; }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}