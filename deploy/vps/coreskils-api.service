[Unit]
Description=CoreSkils API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=coreskils
Group=coreskils
WorkingDirectory=/opt/coreskils/app
EnvironmentFile=/etc/coreskils/api.env
ExecStart=/usr/bin/node --enable-source-maps artifacts/api-server/dist/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/coreskils/app
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target